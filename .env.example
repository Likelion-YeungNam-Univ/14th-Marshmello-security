# Generic OIDC registration. Google example is the default issuer.
OIDC_ISSUER_URI=https://accounts.google.com
OIDC_CLIENT_ID=replace-me.apps.googleusercontent.com
OIDC_CLIENT_SECRET=replace-me

# Minimum scopes for this sample. If you authorize by subject only, you can reduce to openid.
OIDC_SCOPES=openid,email

# Authorization gate: set at least one allow-list entry.
# Comma-separated, case-insensitive for emails/domains.
APP_ALLOWED_EMAILS=your-account@example.com
APP_ALLOWED_EMAIL_DOMAINS=
APP_ALLOWED_SUBJECTS=
APP_REQUIRE_VERIFIED_EMAIL=true

# Optional. Keep false unless you actually need a refresh token.
# For Google this adds access_type=offline and prompt=consent.
OIDC_GOOGLE_OFFLINE_ACCESS=false

# Local HTTP test: false. Production HTTPS: true.
SESSION_COOKIE_SECURE=false
SERVER_PORT=8080
